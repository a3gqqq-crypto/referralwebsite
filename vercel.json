{
  "rewrites": [
    {
      "source": "/m/:momentId",
      "destination": "/api/moment-preview?momentId=:momentId"
    },
    {
      "source": "/join/:ref",
      "destination": "/api/preview?kind=invite&ref=:ref"
    },
    {
      "source": "/u/:username",
      "destination": "/api/preview?kind=profile&username=:username"
    },
    {
      "source": "/squads/:tag",
      "destination": "/api/preview?kind=squad&tag=:tag"
    },
    {
      "source": "/events/:eventId",
      "destination": "/api/preview?kind=event&id=:eventId"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
